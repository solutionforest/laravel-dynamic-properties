{
    "name": "solution-forest/laravel-dynamic-properties",
    "description": "A fast, flexible dynamic property system for Laravel entities",
    "keywords": [
        "laravel",
        "dynamic-properties",
        "eav",
        "custom-fields"
    ],
    "homepage": "https://github.com/solutionforest/laravel-dynamic-properties",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Solution Forest",
            "homepage": "https://solutionforest.com"
        }
    ],
    "support": {
        "issues": "https://github.com/solutionforest/laravel-dynamic-properties/issues",
        "source": "https://github.com/solutionforest/laravel-dynamic-properties"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\LaravelDynamicProperties\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\LaravelDynamicProperties\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.72|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "pint": "pint",
        "pint:test": "pint --test",
        "check": [
            "@pint:test",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\LaravelDynamicProperties\\DynamicPropertyServiceProvider"
            ],
            "aliases": {
                "DynamicProperties": "SolutionForest\\LaravelDynamicProperties\\Facades\\DynamicProperties"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
